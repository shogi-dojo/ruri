# julia-mode.ruri — the julia-mode package (JuliaEditorSupport/julia-emacs)
# converted to Ruri. Original: test/fixtures/julia-mode-original.el
# (v1.1.0, MIT license preserved in test/fixtures/julia-mode-LICENSE.md).
#
# The conversion is semantic, not byte-identical. Deviations from the
# original, each forced by a language gap, with the workaround used:
#
# 1. The generated julia-mode-latexsubs.el data file (~3700 LaTeX
#    abbreviations) has been ported in full. It is a top-level defconst,
#    which Ruri does not express, so the tables are built at runtime by
#    functions and installed through the variable initializers.
# 2. el.defgroup is rejected (name in unevaluated position), so the custom
#    group is omitted; each defcustom passes `group: :languages` directly.
# 3. el.defface is rejected (name in unevaluated position). The two faces
#    are declared through el.custom_declare_face, the function defface
#    expands to, whose face argument is an evaluated position.
# 4. el.syntax_propertize_rules is rejected (whole rule forms unevaluated).
#    The four rules are hand-implemented in julia__syntax_propertize, which
#    is installed as the buffer's syntax-propertize-function.
# 5. el.define_abbrev_table is rejected (its :parents keyword would arrive
#    as a quoted symbol and be silently dropped). Tables are built with
#    el.make_abbrev_table / el.define_abbrev and linked with
#    el.abbrev_table_put. Keywords in evaluated positions use the typed
#    `keyword` construct (make-hash-table's :test, abbrev-table-put's
#    :parents).
# 6. cond / when-let / if-let / cl-flet / cl-loop are rejected: rewritten
#    as if/elsif chains, let + fn, and while loops. The two cl-flet
#    accumulators are small enough to inline.
# 7. The AUCTeX-gated block `(when (featurep 'latex) …)` is omitted:
#    Ruri definitions are unconditional top-level forms, so julia-math-mode
#    and julia-math-insert have no expressible gate.
# 8. derived_mode keyword arguments are not expressible: the original's
#    :abbrev-table keyword becomes an `assign_local :local_abbrev_table`
#    in the body, and :group is dropped (customize UI only).
# 9. All 16 rx forms are pre-expanded to literal regexp strings with batch
#    Emacs, exactly as cmake-mode.ruri does. This one is permanent by
#    design: rx is a sub-language with its own grammar, which Ruri
#    deliberately does not reimplement.
# 10. The `;;;###autoload` cookie is omitted (it is a top-level comment
#     convention). The auto-mode-alist registration itself runs in an
#     init block, but without the cookie package.el cannot autoload
#     M-x julia-mode before the file has been loaded.
# 11. defsubst is rejected (no inlining semantics);
#     julia_syntax_comment_or_string_p is a plain function.
# 12. delete-backward-char is reserved for interactive use by the byte
#     compiler, so its single use is expressed as el.delete_char with a
#     negated count (same region deleted).

require :cl_lib
require :subr_x

variable :julia_mode_hook, nil

custom :julia_indent_offset, 4, "Number of spaces per indentation level.",
       safe: function(:julia__indent_offset_safe), type: :integer, group: :languages

function :julia__indent_offset_safe do |n|
  n > 1 && n <= 8
end

custom :julia_force_tab_complete, true, "Use Tab for completion instead of M-Tab in `julia-mode'.\nThis overrides `tab-always-indent' in `julia-mode' buffers.",
       type: :boolean, group: :languages

custom :julia_automatic_latexsub, true, "After completing a LaTeX symbol, replace it with corresponding unicode.\n`ivy-mode' completion will not trigger automatic latexsub due to\nupstream bug: <https://github.com/abo-abo/swiper/issues/2345>.\n\nUser can still use `abbrev-mode' or `expand-abbrev' to substitute\nunicode for LaTeX even if disabled.",
       type: :boolean, group: :languages

custom :julia_latexsub_greedy, true, "When `t', `julia-latexsub-or-indent' does not offer options when a\ncomplete match is found. Eg for \"\\bar\", \"\\barcap\" etc will not be\noffered in a prompt.",
       type: :boolean, group: :languages

function :julia_latexsub_selector_completing_read do |replacements|
  doc "Use `completing-read' to pick an item from REPLACEMENTS."
  el.completing_read("LaTeX completions: ", replacements, fn do
    true
  end, true)
end

variable :julia_latexsub_selector, function(:julia_latexsub_selector_completing_read),
         "A function that is called when the `julia-latexsub-or-indent' finds\nmultiple matches for a prefix.\n\nThe argument is a list of strings. The function should ALWAYS return\nan item from this list, otherwise an error occurs.\n\nThe default implementation uses `completing-read'."

# The LaTeX substitution table (deviation 1, resolved): all 3,698 entries
# of the generated julia-mode-latexsubs.el data file (vendored at
# test/fixtures/julia-mode-latexsubs-original.el) are emitted here. The
# original file is a top-level defconst; Ruri has no top-level executable
# expressions, so the tables are built by functions and installed through
# the variable initializers.
function :julia__make_latexsubs do
  doc "Build the LaTeX substitution table\n(all 3,698 entries of the generated data file)."
